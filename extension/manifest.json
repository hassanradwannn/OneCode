{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "version": "0.6.4",
  "version_name": "0.6.4",
  "description": "__MSG_extension_description__",
  "default_locale": "en",
  "minimum_chrome_version": "125",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "tabs",
    "tabGroups",
    "debugger"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://contribution.usercontent.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:28765/*",
    "http://127.0.0.1:28766/*",
    "http://127.0.0.1:28767/*",
    "http://127.0.0.1:28768/*",
    "http://127.0.0.1:28769/*",
    "http://127.0.0.1:29765/*",
    "http://127.0.0.1:29766/*",
    "http://127.0.0.1:29767/*",
    "http://127.0.0.1:29768/*",
    "http://127.0.0.1:29769/*",
    "http://127.0.0.1:39765/*",
    "http://127.0.0.1:39766/*",
    "http://127.0.0.1:39767/*",
    "http://127.0.0.1:39768/*",
    "http://127.0.0.1:39769/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "i18n.js",
        "gemini-markdown.js",
        "gemini-dom.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "i18n.js",
        "chatgpt-dom.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "fiber.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "usage.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extension_action_title__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
